# Copy to .env for local development. Every value here is public (it ships inside the app), so no secrets belong in this file.

# Base URL of the Joinly API (no trailing slash). The hosted review API:
EXPO_PUBLIC_API_URL=https://wide-impact-joinly-backend-production.up.railway.app
# Local backend from an Android emulator: http://10.0.2.2:3000

# Google OAuth "Web application" client ID. The app requests ID tokens for this audience,
# and the API verifies them against the same value (GOOGLE_WEB_CLIENT_ID on the backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=509206991044-e4h7gjbmhs98f12th7gfngjo2j3sib2o.apps.googleusercontent.com

# Shows the "Demo accounts" sign-in on the welcome screen. Only works when the API has DEMO_LOGIN_ENABLED=true.
EXPO_PUBLIC_DEMO_LOGIN_ENABLED=true
